# ~/tam/.env — Tam's secrets. Never commit this file.

# Discord bot token (from https://discord.com/developers/applications)
DISCORD_TOKEN=

# Your Discord user ID (right-click yourself → Copy User ID, with Developer Mode on)
# Only this user can talk to Tam. Leave empty to allow anyone (not recommended).
DISCORD_ALLOWED_USER_ID=

# Discord webhook URL for cron notifications
# (Server Settings → Integrations → Webhooks → New Webhook → Copy URL)
DISCORD_WEBHOOK_URL=

# Channel name Tam listens in (default: "tam")
TAM_DISCORD_CHANNEL=tam
